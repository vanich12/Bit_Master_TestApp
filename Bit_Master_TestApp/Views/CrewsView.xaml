<UserControl x:Class="Bit_Master_TestApp.Views.CrewsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bit_Master_TestApp.Views"
      xmlns:viewModels="clr-namespace:Bit_Master_TestApp.ViewModels"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=viewModels:CrewsViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Добавить" 
                    Command="{Binding NavigateToCreateCommand}" />
            <Button Content="Редактировать" 
                    Command="{Binding NavigateToUpdateCommand}" 
                    CommandParameter="{Binding SelectedCrew}" />
            <Button Content="Удалить" 
                    Command="{Binding DeleteCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Items}" 
                  SelectedItem="{Binding SelectedCrew}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Машина" Binding="{Binding Car.Model}" Width="*"/>
                <DataGridTextColumn Header="Госномер" Binding="{Binding Car.LicensePlate}" Width="120"/>
                <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.FullName}" Width="200"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding Active}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
