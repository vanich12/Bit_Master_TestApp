<Application x:Class="Bit_Master_TestApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bit_Master_TestApp"
             xmlns:vm="clr-namespace:Bit_Master_TestApp.ViewModels"
             xmlns:modal="clr-namespace:Bit_Master_TestApp.ViewModels.ModalViewModels"
             xmlns:views="clr-namespace:Bit_Master_TestApp.Views"
             xmlns:windows="clr-namespace:Bit_Master_TestApp.Views.Windows">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:CarsViewModel}">
            <views:CarsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CrewsViewModel}">
            <views:CrewsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type modal:CarModalViewModel}">
            <windows:CarEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type modal:DriverModalViewModel}">
            <windows:DriverEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type modal:CrewModalViewModel}">
            <windows:CrewEditView />
        </DataTemplate>
    </Application.Resources>
</Application>
